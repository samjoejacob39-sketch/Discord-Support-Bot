# ─────────────────────────────────────────────────────────────────────────────
# Shinchat Helper — environment configuration
# This file is git-ignored. Never commit it, never paste it into a chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token, then paste it below.
# Also on that tab: enable MESSAGE CONTENT INTENT (Privileged Gateway Intents).
# Leave "Server Members" and "Presence" OFF — the bot does not use them.
DISCORD_TOKEN=PASTE_YOUR_FRESHLY_RESET_BOT_TOKEN_HERE

# General Information tab → Application ID. Verified to match your token.
DISCORD_APPLICATION_ID=1541110031678967888

# Optional but recommended while setting up: slash commands appear instantly in
# this one server instead of taking up to an hour to propagate globally.
# Get it with Discord → Settings → Advanced → Developer Mode, then right-click
# your server name → Copy Server ID. Clear this before going live.
DISCORD_DEV_GUILD_ID=

# ── AI provider ──────────────────────────────────────────────────────────────
# "gemini" for real answers, "mock" to run the whole bot offline with canned
# replies (useful for testing Discord wiring without spending quota).
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey → Create API key.
# The value MUST start with "AIzaSy" and be 39 characters. If yours starts with
# anything else you have copied an OAuth token, not an API key.
GEMINI_API_KEY=PASTE_YOUR_NEW_AIzaSy_KEY_HERE

# Conversational model, and the cheaper one used for classification,
# summarisation and category inference. These defaults are the right starting
# point: flash is fast and cheap enough for support traffic.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# ── Web search / fetch ───────────────────────────────────────────────────────
# "none" | "brave" | "tavily" | "duckduckgo"
# Start with "none": the bot answers from what you teach it plus the model's own
# knowledge, which is what you want until your /learn entries exist. Turn search
# on later if members ask about live status, versions or current events.
#   brave  → https://api.search.brave.com/app/keys  (free tier available)
#   tavily → https://app.tavily.com  (search API built for LLMs)
#   duckduckgo → no key, best-effort HTML scrape, can break without warning
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Page fetching works independently of search: it lets the AI open a link that
# appears in the conversation or in your knowledge (e.g. your status page).
# Every fetch is SSRF-guarded and the page is treated as untrusted data.
WEB_FETCH_ENABLED=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Created on first run. Back this file up — it holds everything you teach the
# bot, all tickets, admins and settings.
DATABASE_PATH=./data/shinchat.sqlite

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set NODE_ENV=production on your server: it switches logs to structured JSON
# instead of the coloured human-readable format.
NODE_ENV=development
LOG_LEVEL=info

# Log shape, independent of NODE_ENV: "pretty" for a terminal you watch,
# "json" for a log aggregator, "auto" = json in production, pretty otherwise.
LOG_FORMAT=pretty

# Cost / abuse controls. These defaults are deliberately conservative — one
# member cannot burn your Gemini quota, and neither can one busy server.
AI_MAX_REQUESTS_PER_USER_PER_MIN=6
AI_MAX_REQUESTS_PER_GUILD_PER_MIN=40
AI_MAX_TOOL_ITERATIONS=5
AI_CONTEXT_MESSAGE_LIMIT=14
