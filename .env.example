# ─────────────────────────────────────────────────────────────────────────────
# Shinchat Helper — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
# 1. Go to https://discord.com/developers/applications → New Application
# 2. Bot tab → Reset Token → copy it here
# 3. Bot tab → enable "MESSAGE CONTENT INTENT" (required to read ticket messages)
# 4. Installation tab → scopes: bot + applications.commands
#    Permissions: View Channels, Send Messages, Send Messages in Threads,
#                 Read Message History, Embed Links   (permissions=274877991936)
#    Never grant Administrator.
DISCORD_TOKEN=your_discord_bot_token_here

# Application ("Client") ID from the General Information tab.
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Optional: register slash commands instantly to one guild while developing.
# Leave empty in production so commands register globally.
DISCORD_DEV_GUILD_ID=

# ── AI provider ──────────────────────────────────────────────────────────────
# "gemini" (default) or "mock" (offline / test mode, no API calls).
AI_PROVIDER=gemini

# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# (Sign in → "Get API key" → "Create API key". Free tier is enough to start.)
# Alternatively set AI_PROVIDER=mock to run with no API calls at all.
GEMINI_API_KEY=your_gemini_api_key_here

# Main conversational model + the cheaper model used for classification,
# summarisation and category inference.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# ── Web search / fetch ───────────────────────────────────────────────────────
# Provider: "none" | "brave" | "tavily" | "duckduckgo"
#   none        → web search disabled (bot still answers from knowledge + model)
#   brave       → https://api.search.brave.com/app/keys
#   tavily      → https://app.tavily.com  (search API built for LLMs)
#   duckduckgo  → no API key, best-effort HTML scrape, may break
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Allow the AI to fetch and read arbitrary public webpages (SSRF-guarded).
WEB_FETCH_ENABLED=true

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file path. Use ":memory:" for ephemeral test runs.
DATABASE_PATH=./data/shinchat.sqlite

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Cost / abuse controls
AI_MAX_REQUESTS_PER_USER_PER_MIN=6
AI_MAX_REQUESTS_PER_GUILD_PER_MIN=40
AI_MAX_TOOL_ITERATIONS=5
AI_CONTEXT_MESSAGE_LIMIT=14
